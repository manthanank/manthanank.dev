---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string[];
  skills?: string[];
  colleagues?: string[];
}

const { title, company, period, description, skills = [], colleagues = [] } = Astro.props;
---

<div class="experience-item">
  <div class="timeline-dot"></div>
  <div 
    class="experience-content"
    data-milestone
    data-title={title}
    data-company={company}
    data-period={period}
    data-description={JSON.stringify(description)}
    data-skills={JSON.stringify(skills)}
    data-colleagues={JSON.stringify(colleagues)}
  >
    <div class="experience-header">
      <h3 class="experience-title">{title}</h3>
      <span class="experience-period">{period}</span>
    </div>
    <div class="experience-company-row">
      <p class="experience-company">{company}</p>
      <span class="experience-more-badge">View Milestone ✦</span>
    </div>
    <ul class="experience-list">
      {description.slice(0, 2).map((item) => (
        <li>{item}</li>
      ))}
      {description.length > 2 && <li class="more-indicator">Click card to read more accomplishments...</li>}
    </ul>
  </div>
</div>

<style>
  .experience-item {
    position: relative;
    padding-left: 3rem;
    padding-bottom: 3.5rem;
  }

  .experience-item:last-child {
    padding-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -6px; /* Offset to center on the 2px line */
    top: 6px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-bg-card);
    border: 3px solid var(--color-border);
    transition: all 0.6s cubic-bezier(0.5, 0, 0, 1);
    z-index: 2;
  }

  .experience-item.active .timeline-dot {
    background: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: 0 0 15px var(--color-primary);
    transform: scale(1.2);
  }

  .experience-content {
    padding: 1.5rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateY(20px);
    opacity: 0;
    cursor: pointer;
  }

  .experience-item.active .experience-content {
    transform: translateY(0);
    opacity: 1;
    border-color: rgba(0, 212, 255, 0.2);
    background: rgba(0, 212, 255, 0.02);
  }

  .experience-content:hover {
    border-color: var(--color-primary) !important;
    background: rgba(0, 212, 255, 0.05) !important;
    transform: translateY(-4px) scale(1.01) !important;
    box-shadow: 0 10px 30px rgba(0, 212, 255, 0.1);
  }

  .experience-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .experience-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .experience-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-primary);
    background: rgba(0, 212, 255, 0.08);
    padding: 0.2rem 0.75rem;
    border-radius: 20px;
  }

  .experience-company-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .experience-company {
    color: var(--color-text-muted);
    font-weight: 500;
    margin: 0;
  }

  .experience-more-badge {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(0, 212, 255, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    opacity: 0.7;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .experience-content:hover .experience-more-badge {
    opacity: 1;
    transform: scale(1.05);
  }

  .experience-list {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .experience-list li {
    position: relative;
    padding-left: 1.25rem;
    list-style: none;
  }

  .experience-list li::before {
    content: '▹';
    position: absolute;
    left: 0;
    color: var(--color-primary);
  }

  .more-indicator {
    color: var(--color-primary) !important;
    font-style: italic;
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }
</style>
