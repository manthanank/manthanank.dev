---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { db, PageViews, PageLikes } from 'astro:db';
import { isExcludedRepo } from '../data/excluded-repos';
import { theLearningHubRepos } from '../data/thelearninghub';

const localProjects = await getCollection('projects');
const projectSlugsMap = new Map(localProjects.map(p => [p.id, p.id]));
const projectTitlesMap = new Map(localProjects.map(p => [p.data.title.toLowerCase(), p.id]));

// Work Projects (Tech Ventures Group)
const workProjectsData = [
  {
    title: 'Handoff',
    description: 'Test-drive and service-pickup damage proof for automotive dealerships: mobile-first vehicle condition capture, loaner tracking, and dispute-proof claim packets.',
    tags: ['TypeScript', 'PostgreSQL', 'Supabase', 'Next.js', 'Automotive'],
    live: 'https://handoff.3-130-85-220.sslip.io/',
    company: 'Tech Ventures Group',
    slug: 'handoff',
  },
  {
    title: 'CarePulse',
    description: '20-second patient check-ins and remote patient monitoring for clinics: daily check-ins, alert triage queue, and automated CMS CPT billing time tracking.',
    tags: ['TypeScript', 'PostgreSQL', 'Supabase', 'Healthcare', 'Next.js'],
    live: 'https://carepulse.3-130-85-220.sslip.io/',
    company: 'Tech Ventures Group',
    slug: 'carepulse',
  },
  {
    title: 'ReconOS',
    description: 'Reconditioning software for used-car dealerships: the shop Kanban board, stage SLA timers, legacy DMS migration engine, and self-hosted Docker/EC2 infrastructure.',
    tags: ['Next.js', 'TypeScript', 'Supabase', 'PostgreSQL', 'Docker', 'AWS'],
    company: 'Tech Ventures Group',
    slug: 'reconos',
  },
  {
    title: 'DealerDash AI',
    description: 'AI-powered, human-driven dealership KPI dashboard and operational intelligence platform with predictive scoring, expense analysis, and industry benchmark analytics.',
    tags: ['Next.js', 'TypeScript', 'AI', 'Automotive', 'Analytics'],
    live: 'https://dealerdash.ai/',
    company: 'Tech Ventures Group',
    slug: 'dealerdash',
  },
];

// Production Landing Pages
const landingProjectsData = [
  {
    title: 'CoverDrive Cricket Academy',
    description: 'Elite cricket performance platform featuring interactive bat swing telemetry and 22-yard pitch simulation.',
    tags: ['Next.js', 'React', 'Tailwind CSS', 'Framer Motion', 'SportsTech'],
    github: 'https://github.com/manthanank/coverdrive-cricket',
    live: 'https://coverdrive-cricket.vercel.app',
    slug: 'coverdrive-cricket',
  },
  {
    title: 'Nexus Agents',
    description: 'Autonomous multi-agent AI orchestration and deterministic governance platform with sub-100ms MCP tool calling.',
    tags: ['Next.js', 'React', 'Framer Motion', 'AI Agents', 'MCP'],
    github: 'https://github.com/manthanank/nexus-landing',
    live: 'https://nexus-landing-app.vercel.app',
    slug: 'nexus-landing',
  },
  {
    title: 'Aegis Zero-Trust',
    description: 'Cloud security posture management and zero-trust runtime policy compiler engine.',
    tags: ['Next.js', 'React', 'Tailwind CSS', 'Cybersecurity', 'Zero-Trust'],
    github: 'https://github.com/manthanank/aegis-landing',
    live: 'https://aegis-landing-app.vercel.app',
    slug: 'aegis-landing',
  },
  {
    title: 'Trace Observability',
    description: 'Sub-millisecond OpenTelemetry distributed span ingestion powered by eBPF kernel probes and ClickHouse.',
    tags: ['Next.js', 'React', 'eBPF', 'Observability', 'OpenTelemetry'],
    github: 'https://github.com/manthanank/trace-landing',
    live: 'https://trace-landing-app.vercel.app',
    slug: 'trace-landing',
  },
  {
    title: 'FreshCart Grocers',
    description: 'Hyper-local farm-fresh grocery delivery within 30 minutes, featuring live cart drawer and grower traceability.',
    tags: ['React', 'Tailwind CSS', 'E-Commerce', 'UX Design'],
    github: 'https://github.com/manthanank/freshcart-landing',
    live: 'https://freshcart-landing.vercel.app',
    slug: 'freshcart-landing',
  },
  {
    title: 'Landing Forge',
    description: 'Production-ready Next.js landing page scaffolding and preset architecture engine for high-velocity software engineering.',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Developer Tools'],
    github: 'https://github.com/manthanank/landing-forge',
    live: 'https://landing-forge-app.vercel.app',
    slug: 'landing-forge',
  },
];

// TheLearningHubOrg Curricula
const learningHubProjects = theLearningHubRepos.map(repo => ({
  ...repo,
  slug: projectSlugsMap.get(repo.slug || repo.name) || (projectTitlesMap.get(repo.title.toLowerCase()) ?? undefined)
}));

const resumeProjects = [
  {
    title: 'Patient Discharge and Call Monitoring Web App',
    description: 'Part of a multi-role hospital management system. Implemented real-time communication using Socket.IO and deployed on AWS for scalability.',
    tags: ['Angular', 'Node.js', 'MySQL', 'Socket.IO', 'AWS'],
    company: 'Blackcoffer',
  },
  {
    title: 'API Admin & Client Dashboard',
    description: 'Developed comprehensive admin and client dashboards from the ground up, integrating over 150 APIs with robust Authentication and Authorization mechanisms.',
    tags: ['Angular', 'REST APIs', 'UI/UX', 'Dashboard'],
    company: 'Blackcoffer',
  },
  {
    title: 'Brain Tumor Detection',
    description: 'Final year project involving image detection and classification using MRI images. Utilized Flask for the frontend and specialized in testing and training methods.',
    tags: ['Flask', 'Python', 'Machine Learning', 'Healthcare'],
  },
  {
    title: 'Complaint Management System',
    description: 'A web development project featuring a responsive interface for registering and storing complaints in a structured database.',
    tags: ['PHP', 'MySQL', 'Web Development'],
  },
  {
    title: 'Census Management System',
    description: 'A DBMS project designed to store and manage census data with high performance and thorough testing.',
    tags: ['DBMS', 'SQL', 'Data Management'],
  }
];

const GITHUB_TOKEN = import.meta.env.GITHUB_TOKEN;
const GITHUB_USERNAME = 'manthanank';

const query = `
  query ($username: String!) {
    user(login: $username) {
      repositories(first: 20, privacy: PUBLIC, orderBy: {field: UPDATED_AT, direction: DESC}, ownerAffiliations: OWNER, isFork: false) {
        nodes {
          name
          description
          url
          homepageUrl
          stargazerCount
          languages(first: 3, orderBy: {field: SIZE, direction: DESC}) {
            nodes {
              name
            }
          }
          isArchived
        }
      }
    }
  }
`;

let otherProjects: any[] = [];

try {
  const res = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${GITHUB_TOKEN}`,
    },
    body: JSON.stringify({
      query,
      variables: { username: GITHUB_USERNAME },
    }),
  });

  if (res.ok) {
    const { data } = await res.json();
    const user = data?.user;

    const knownSlugs = new Set([
      ...workProjectsData.map(p => p.slug),
      ...landingProjectsData.map(p => p.slug),
      'coverdrive-cricket', 'nexus-landing', 'aegis-landing', 'trace-landing', 'freshcart-landing', 'landing-forge',
      'handoff', 'carepulse', 'reconos', 'dealerdash'
    ]);

    otherProjects = user?.repositories?.nodes
      .filter((repo: any) => !repo.isArchived && !isExcludedRepo(repo.name) && !knownSlugs.has(repo.name.toLowerCase()))
      .slice(0, 8)
      .map((repo: any) => {
        const title = repo.name.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
        const slug = projectSlugsMap.get(repo.name.toLowerCase()) || projectTitlesMap.get(title.toLowerCase());
        return {
          title,
          description: repo.description || '',
          tags: repo.languages?.nodes.map((l: any) => l.name) || [],
          github: repo.url,
          live: repo.homepageUrl || undefined,
          stars: repo.stargazerCount,
          slug
        };
      }) || [];
  } else {
    throw new Error('GraphQL request failed');
  }
} catch (e) {
  otherProjects = [
    {
      title: 'manthanank.dev',
      description: 'My portfolio site built with Astro for fast performance, SEO, and a modern UI.',
      tags: ['Astro', 'TypeScript', 'CSS'],
      github: 'https://github.com/manthanank/manthanank.dev',
      live: 'https://manthanank.dev',
    },
    {
      title: 'E-Commerce App',
      description: 'A full-featured e-commerce application with product listings, cart, checkout, and payment integration.',
      tags: ['Angular', 'Node.js', 'Stripe', 'MongoDB'],
      github: 'https://github.com/manthanank/ecommerce-app',
    },
  ];
}

// Work & Career Projects (Merged Tech Ventures Group + Resume Systems)
const workAndCareerProjects = [
  ...workProjectsData,
  ...resumeProjects
];

const allViews = await db.select().from(PageViews);
const allLikes = await db.select().from(PageLikes);

const viewsMap = new Map(allViews.map(v => [v.slug, v.count]));
const likesMap = new Map(allLikes.map(l => [l.slug, l.count]));

// Extract unique tags across all projects for filtering
const allProjectsCombined = [
  ...workAndCareerProjects,
  ...landingProjectsData,
  ...learningHubProjects,
  ...otherProjects
];
const allTags = Array.from(new Set(allProjectsCombined.flatMap(p => p.tags || []))).sort();
---

<BaseLayout title="Projects | Manthan Ankolekar" description="Production client systems, landing page architectures, open-source curricula, and career projects by Manthan Ankolekar, full-stack software engineer.">
  <section class="section projects-hero">
    <div class="container">
      <h1 class="section-title">Projects</h1>
      <p class="section-subtitle">Production client systems, interactive landing page architectures, and open-source curricula.</p>
    </div>
  </section>

  <!-- Filter Buttons Section -->
  <section class="container filter-section reveal">
    <div class="filter-wrapper">
      <span class="filter-label">Filter Tech:</span>
      <div class="filter-tags" id="filter-tags">
        <button class="filter-tag-btn active" data-filter="all">All</button>
        {allTags.map(tag => (
          <button class="filter-tag-btn" data-filter={tag.toLowerCase()}>{tag}</button>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 1: Work & Career Projects (Merged Tech Ventures Group + Career Systems) -->
  <section class="container work-projects-section">
    <div class="section-header-block">
      <h2 class="subsection-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        Work & Career Projects
      </h2>
      <p class="section-desc">Production SaaS platforms, multi-tenant databases, and enterprise systems engineered at <strong>Tech Ventures Group</strong>, <strong>Blackcoffer</strong>, and throughout my software engineering career.</p>
    </div>
    <div class="projects-grid pinned-grid">
      {workAndCareerProjects.map((project) => (
        <div class="project-card-item" data-tags={(project.tags || []).map((t: string) => t.toLowerCase()).join(',')}>
          <ProjectCard 
            {...project} 
            views={(project as any).slug ? viewsMap.get((project as any).slug) : undefined}
            likes={(project as any).slug ? likesMap.get((project as any).slug) : undefined}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Section 2: Interactive Landing Page Systems -->
  <section class="container landing-pages-section">
    <div class="section-header-block">
      <h2 class="subsection-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
        Interactive Landing Page Systems
      </h2>
      <p class="section-desc">High-velocity landing applications with interactive browser telemetry, design system presets, zero-trust compilers, and live e-commerce workflows.</p>
    </div>
    <div class="projects-grid pinned-grid">
      {landingProjectsData.map((project) => (
        <div class="project-card-item" data-tags={(project.tags || []).map((t: string) => t.toLowerCase()).join(',')}>
          <ProjectCard 
            {...project} 
            views={project.slug ? viewsMap.get(project.slug) : undefined}
            likes={project.slug ? likesMap.get(project.slug) : undefined}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Section 3: TheLearningHubOrg Open Source Curriculum -->
  <section class="container learninghub-section">
    <div class="section-header-block learninghub-header-block">
      <div class="learninghub-title-row">
        <h2 class="subsection-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/></svg>
          TheLearningHubOrg
        </h2>
        <a href="https://github.com/TheLearningHubOrg" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm org-link-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          Visit Organization (30 Guides)
        </a>
      </div>
      <p class="section-desc">Open-source engineering curricula maintained across 30 repositories covering modern web frameworks, systems architecture, distributed databases, and cloud engineering.</p>
    </div>
    <div class="projects-grid">
      {learningHubProjects.map((project) => (
        <div class="project-card-item" data-tags={(project.tags || []).map((t: string) => t.toLowerCase()).join(',')}>
          <ProjectCard 
            {...project} 
            views={project.slug ? viewsMap.get(project.slug) : undefined}
            likes={project.slug ? likesMap.get(project.slug) : undefined}
          />
        </div>
      ))}
    </div>
  </section>

  <!-- Section 4: Other Open Source Projects -->
  {otherProjects.length > 0 && (
    <section class="container projects-section">
      <div class="section-header-block">
        <h2 class="subsection-title">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          More Open Source Repositories
        </h2>
        <p class="section-desc">Personal utilities, developer portfolios, and experiments pushed directly to GitHub.</p>
      </div>
      <div class="projects-grid">
        {otherProjects.map((project) => (
          <div class="project-card-item" data-tags={(project.tags || []).map((t: string) => t.toLowerCase()).join(',')}>
            <ProjectCard {...project} />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="container">
    <div class="github-cta">
      <p>Interested in exploring all code repositories, scripts, and architectural case studies?</p>
      <a href="https://github.com/manthanank" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-magnetic">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        Follow on GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  function initProjectFilters() {
    const buttons = document.querySelectorAll('.filter-tag-btn');
    const cards = document.querySelectorAll('.project-card-item');

    if (buttons.length === 0 || cards.length === 0) return;

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || 'all';

        cards.forEach((card: any) => {
          const tags = card.getAttribute('data-tags') || '';
          const tagList = tags.split(',');

          if (filter === 'all' || tagList.includes(filter)) {
            card.style.display = 'block';
            requestAnimationFrame(() => {
              card.style.opacity = '1';
              card.style.transform = 'scale(1)';
              card.style.transition = 'opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
            });
          } else {
            card.style.opacity = '0';
            card.style.transform = 'scale(0.95)';
            card.style.transition = 'opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1), transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)';
            setTimeout(() => {
              const activeBtn = document.querySelector('.filter-tag-btn.active');
              const activeFilter = activeBtn ? activeBtn.getAttribute('data-filter') : 'all';
              if (activeFilter === filter) {
                card.style.display = 'none';
              }
            }, 400);
          }
        });
      });
    });
  }

  // Initial load
  initProjectFilters();

  // Astro page transitions support
  document.addEventListener('astro:after-swap', initProjectFilters);
</script>

<style>
  .projects-hero {
    padding-top: 8rem;
    padding-bottom: 0;
  }

  /* Filters */
  .filter-section {
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .filter-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
    border-radius: var(--radius);
    overflow-x: auto;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .filter-tags {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter-tags::-webkit-scrollbar {
    display: none;
  }

  .filter-tag-btn {
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 99px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition);
    white-space: nowrap;
  }

  .filter-tag-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-tag-btn.active {
    background: var(--color-primary);
    color: #fff;
    border-color: var(--color-primary);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.2);
  }

  .work-projects-section,
  .landing-pages-section,
  .learninghub-section,
  .projects-section {
    padding-bottom: 4rem;
  }

  .section-header-block {
    margin-bottom: 1.75rem;
  }

  .section-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-top: 0.35rem;
    line-height: 1.5;
  }

  .learninghub-header-block {
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), rgba(124, 58, 237, 0.05));
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }

  .learninghub-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .org-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    padding: 0.45rem 1rem;
    border-radius: 99px;
  }

  .subsection-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .subsection-title svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 1.5rem;
  }

  .pinned-grid {
    grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
  }

  .github-cta {
    text-align: center;
    margin-top: 2rem;
    margin-bottom: 4rem;
    padding: 3rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .github-cta p {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .projects-hero {
      padding-top: 6rem;
    }

    .subsection-title {
      font-size: 1.15rem;
    }

    .projects-grid,
    .pinned-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .learninghub-title-row {
      flex-direction: column;
      align-items: flex-start;
    }

    .github-cta {
      padding: 2rem 1.25rem;
    }
  }
</style>
