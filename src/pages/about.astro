  <script>
    function initTimeline() {
      const timeline = document.querySelector('.experience-timeline');
      const progress = document.querySelector('.timeline-progress') as HTMLElement;
      const items = document.querySelectorAll('.experience-item');

      if (!timeline || !progress) return;

      const observerOptions = {
        root: null,
        threshold: 0.5,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      }, observerOptions);

      items.forEach((item) => observer.observe(item));

      window.addEventListener('scroll', () => {
        const rect = timeline.getBoundingClientRect();
        const windowHeight = window.innerHeight;
        
        // Calculate progress based on timeline position in viewport
        if (rect.top < windowHeight && rect.bottom > 0) {
          const totalHeight = rect.height;
          const visiblePart = windowHeight - rect.top;
          const percentage = Math.min(100, Math.max(0, (visiblePart / (totalHeight + 100)) * 100));
          progress.style.height = `${percentage}%`;
        }
      });
    }

    function initMilestonePopups() {
      const cards = document.querySelectorAll('[data-milestone]');
      const modal = document.getElementById('milestone-modal');
      const backdrop = modal?.querySelector('.modal-backdrop');
      const closeBtn = modal?.querySelector('.modal-close');

      if (!modal || !closeBtn) return;

      function openModal(card: Element) {
        const title = card.getAttribute('data-title') || '';
        const company = card.getAttribute('data-company') || '';
        const period = card.getAttribute('data-period') || '';
        const description = JSON.parse(card.getAttribute('data-description') || '[]');
        const skills = JSON.parse(card.getAttribute('data-skills') || '[]');
        const colleagues = JSON.parse(card.getAttribute('data-colleagues') || '[]');

        const periodEl = modal!.querySelector('.modal-meta-period');
        const titleEl = modal!.querySelector('.modal-title');
        const companyEl = modal!.querySelector('.modal-company');
        const accomplishmentsEl = modal!.querySelector('.modal-accomplishments-list');
        const skillsEl = modal!.querySelector('.modal-skills-grid');
        const colleaguesEl = modal!.querySelector('.modal-colleagues-list');

        if (periodEl) periodEl.textContent = period;
        if (titleEl) titleEl.textContent = title;
        if (companyEl) companyEl.textContent = company;

        if (accomplishmentsEl) {
          accomplishmentsEl.innerHTML = description.map((desc: string) => `<li>${desc}</li>`).join('');
        }

        if (skillsEl) {
          skillsEl.innerHTML = skills.map((skill: string) => `<span class="modal-skill-tag">${skill}</span>`).join('');
        }

        if (colleaguesEl) {
          colleaguesEl.innerHTML = colleagues.map((col: string) => `<div class="modal-colleague-item">${col}</div>`).join('');
        }

        modal!.classList.add('open');
        modal!.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';

        // Play click chime!
        // @ts-ignore
        if (window.playSynthSound) {
          // @ts-ignore
          window.playSynthSound('click');
        }
      }

      function closeModal() {
        modal!.classList.remove('open');
        modal!.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';

        // Play hover pop sound!
        // @ts-ignore
        if (window.playSynthSound) {
          // @ts-ignore
          window.playSynthSound('hover');
        }
      }

      cards.forEach(card => {
        card.addEventListener('click', () => openModal(card));
      });

      closeBtn.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', closeModal);

      // Escape key close
      const handleKeyDown = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && modal!.classList.contains('open')) {
          closeModal();
        }
      };
      window.addEventListener('keydown', handleKeyDown);
    }

    function initProficiencyChart() {
      const chart = document.getElementById('proficiency-chart');
      if (!chart) return;

      const bars = chart.querySelectorAll('.chart-bar');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            bars.forEach(bar => {
              const pct = bar.getAttribute('data-pct');
              (bar as HTMLElement).style.width = pct + '%';
            });
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      observer.observe(chart);
    }

    // Run on load
    initTimeline();
    initMilestonePopups();
    initProficiencyChart();

    // Run after view transitions
    document.addEventListener('astro:after-swap', () => {
      initTimeline();
      initMilestonePopups();
      initProficiencyChart();
    });
  </script>
