---
import BaseLayout from '../layouts/BaseLayout.astro';

const suggestions = [
  "What is Manthan's core tech stack?",
  "Tell me about his experience at BlackCoffer.",
  "Is he open to remote opportunities?",
  "Where did he study and when?",
];
---

<BaseLayout title="AI Assistant | Manthan Ankolekar" description="Chat with Manthan's Gemini-powered AI Portfolio Assistant.">
  <section class="section chat-hero">
    <div class="container">
      <h1 class="section-title">AI Portfolio Assistant</h1>
      <p class="section-subtitle">Ask questions about Manthan's technical expertise, project experience, or availability.</p>
    </div>
  </section>

  <section class="container chat-section">
    <div class="chat-container reveal">
      <div class="chat-header">
        <div class="bot-profile">
          <div class="bot-avatar">
            <span class="bot-pulse"></span>
            🤖
          </div>
          <div class="bot-info">
            <h3>Manthan's AI Agent</h3>
            <p>Powered by Gemini 2.5 Flash</p>
          </div>
        </div>
        <button id="clear-chat" class="btn-clear" title="Clear chat history">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
        </button>
      </div>

      <!-- Suggestion chips -->
      <div class="suggestion-row" id="suggestions-container">
        {suggestions.map(s => (
          <button class="chip suggestion-chip">{s}</button>
        ))}
      </div>

      <!-- Messages Window -->
      <div class="chat-window" id="chat-window">
        <div class="message assistant-message">
          <div class="message-bubble">
            Hi! I'm Manthan's AI Portfolio Assistant. Ask me anything about his technical experience, tools, education, or work achievements!
          </div>
          <span class="message-time">Just Now</span>
        </div>
      </div>

      <!-- Typing Indicator -->
      <div class="typing-indicator" id="typing-indicator" style="display: none;">
        <span class="dot"></span>
        <span class="dot"></span>
        <span class="dot"></span>
      </div>

      <!-- Input box -->
      <form class="chat-input-wrapper" id="chat-form">
        <input 
          type="text" 
          id="chat-input"
          placeholder="Ask a question..."
          autocomplete="off"
          required
        />
        <button type="submit" class="btn-send" id="btn-send" aria-label="Send message">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" x2="11" y1="2" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  interface Message {
    role: 'user' | 'assistant';
    content: string;
    time: string;
  }

  function initChat() {
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const windowEl = document.getElementById('chat-window') as HTMLDivElement;
    const typing = document.getElementById('typing-indicator') as HTMLDivElement;
    const clearBtn = document.getElementById('clear-chat');
    const suggestionsCont = document.getElementById('suggestions-container');
    const chips = document.querySelectorAll('.suggestion-chip');

    if (!form || !input || !windowEl) return;

    let chatHistory: Message[] = [];

    // Load from SessionStorage to persist across refreshes
    const savedHistory = sessionStorage.getItem('manthan_ai_chat');
    if (savedHistory) {
      chatHistory = JSON.parse(savedHistory);
      renderHistory();
    }

    function renderHistory() {
      // Clear all but first welcome message
      const welcome = windowEl.firstElementChild;
      windowEl.innerHTML = '';
      if (welcome) windowEl.appendChild(welcome);

      chatHistory.forEach(msg => {
        appendMessageElement(msg.role, msg.content, msg.time);
      });
      scrollToBottom();
    }

    function appendMessageElement(role: 'user' | 'assistant', text: string, timeStr: string) {
      const msgDiv = document.createElement('div');
      msgDiv.className = `message ${role}-message`;
      
      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';
      
      // Simple markdown parser for Gemini response
      bubble.innerHTML = parseMarkdown(text);
      
      const timeSpan = document.createElement('span');
      timeSpan.className = 'message-time';
      timeSpan.textContent = timeStr;
      
      msgDiv.appendChild(bubble);
      msgDiv.appendChild(timeSpan);
      
      windowEl.appendChild(msgDiv);
    }

    function parseMarkdown(text: string) {
      // Basic formatting (bold, list items, paragraphs)
      return text
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/^\s*\*\s+(.*?)$/gm, '<li>$1</li>')
        .replace(/(<li>.*?<\/li>)/g, '<ul>$1</ul>')
        // Clean up nested <ul> tags
        .replace(/<\/ul>\s*<ul>/g, '')
        .split('\n\n')
        .map(p => p.trim().startsWith('<ul') || p.trim().startsWith('<li') ? p : `<p>${p}</p>`)
        .join('');
    }

    function scrollToBottom() {
      windowEl.scrollTop = windowEl.scrollHeight;
    }

    async function handleSendMessage(text: string) {
      if (!text.trim()) return;

      // Add to UI
      const time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      appendMessageElement('user', text, time);
      chatHistory.push({ role: 'user', content: text, time });
      sessionStorage.setItem('manthan_ai_chat', JSON.stringify(chatHistory));

      input.value = '';
      scrollToBottom();

      // Show typing indicator
      if (typing) typing.style.display = 'flex';
      scrollToBottom();

      // Hide suggestions after first message
      if (suggestionsCont) {
        suggestionsCont.style.transition = 'opacity 0.3s ease';
        suggestionsCont.style.opacity = '0';
        setTimeout(() => suggestionsCont.remove(), 300);
      }

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: chatHistory }),
        });

        const data = await res.json();
        
        if (typing) typing.style.display = 'none';

        if (res.ok && data.reply) {
          const replyTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
          appendMessageElement('assistant', data.reply, replyTime);
          chatHistory.push({ role: 'assistant', content: data.reply, time: replyTime });
          sessionStorage.setItem('manthan_ai_chat', JSON.stringify(chatHistory));
        } else {
          appendMessageElement('assistant', "I'm sorry, I'm experiencing technical issues. Please check back later!", time);
        }
      } catch (err) {
        if (typing) typing.style.display = 'none';
        appendMessageElement('assistant', "Connection lost. Please check your network and try again.", time);
      }
      scrollToBottom();
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      handleSendMessage(val);
    });

    chips.forEach(chip => {
      chip.addEventListener('click', () => {
        const query = chip.textContent || '';
        handleSendMessage(query);
      });
    });

    clearBtn?.addEventListener('click', () => {
      sessionStorage.removeItem('manthan_ai_chat');
      chatHistory = [];
      renderHistory();
      
      // Reload page to bring back chips if needed, or simply reload state
      window.location.reload();
    });
  }

  initChat();
  document.addEventListener('astro:after-swap', initChat);
</script>

<style>
  .chat-hero {
    padding-top: 8rem;
    padding-bottom: 2rem;
  }

  .chat-section {
    padding-bottom: 5rem;
    max-width: 800px;
  }

  .chat-container {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 600px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }

  .chat-header {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .bot-profile {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .bot-avatar {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    position: relative;
  }

  .bot-pulse {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    border: 1px solid var(--color-bg-card);
  }

  .bot-info h3 {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
  }

  .bot-info p {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .btn-clear {
    background: none;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 8px;
    border-radius: 8px;
    transition: all var(--transition);
    display: flex;
  }

  .btn-clear:hover {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }

  /* Suggestion Chips */
  .suggestion-row {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 1.5rem 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .suggestion-row::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 99px;
    color: var(--color-text);
    cursor: pointer;
    transition: all var(--transition);
  }

  .chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: rgba(0, 212, 255, 0.05);
    transform: translateY(-1px);
  }

  /* Chat Window */
  .chat-window {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .message {
    max-width: 80%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .assistant-message {
    align-self: flex-start;
  }

  .user-message {
    align-self: flex-end;
  }

  .message-bubble {
    padding: 1rem 1.25rem;
    border-radius: 18px;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .assistant-message .message-bubble {
    background: var(--color-bg-alt);
    color: var(--color-text);
    border-top-left-radius: 4px;
    border: 1px solid var(--color-border);
  }

  .user-message .message-bubble {
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    color: #fff;
    border-top-right-radius: 4px;
  }

  /* Markdown custom inside bubbles */
  .message-bubble :global(p) {
    margin-bottom: 0.75rem;
  }
  .message-bubble :global(p:last-child) {
    margin-bottom: 0;
  }
  .message-bubble :global(strong) {
    font-weight: 700;
  }
  .message-bubble :global(ul) {
    padding-left: 1.25rem;
    margin-bottom: 0.75rem;
    list-style-type: disc;
  }

  .message-time {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    padding: 0 4px;
  }

  .user-message .message-time {
    align-self: flex-end;
  }

  /* Typing Indicator */
  .typing-indicator {
    align-self: flex-start;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0.6rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    border-top-left-radius: 2px;
  }

  .typing-indicator .dot {
    width: 6px;
    height: 6px;
    background: var(--color-text-muted);
    border-radius: 50%;
    animation: typing-dot 1.4s infinite ease-in-out;
  }

  .typing-indicator .dot:nth-child(1) { animation-delay: 0s; }
  .typing-indicator .dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-indicator .dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typing-dot {
    0%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
  }

  /* Input wrapper */
  .chat-input-wrapper {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 0.75rem;
    background: var(--color-bg-card);
  }

  #chat-input {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 0.75rem 1.25rem;
    color: var(--color-text);
    outline: none;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color var(--transition);
  }

  #chat-input:focus {
    border-color: var(--color-primary);
  }

  .btn-send {
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    color: #fff;
    border: none;
    border-radius: 12px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all var(--transition);
  }

  .btn-send:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(0, 212, 255, 0.2);
  }

  .btn-send:active {
    transform: translateY(0);
  }
</style>
