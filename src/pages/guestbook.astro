---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { db, Guestbook as GuestbookTable, desc } from 'astro:db';

let error = '';
let success = false;

if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const name = data.get('name')?.toString();
    const email = data.get('email')?.toString() || null;
    const message = data.get('message')?.toString();
    const botField = data.get('bot-field')?.toString();

    // Honeypot check
    if (botField) {
      throw new Error('Bot detected');
    }

    if (!name || !message) {
      error = 'Name and message are required.';
    } else {
      const id = crypto.randomUUID();
      await db.insert(GuestbookTable).values({
        id,
        name,
        email,
        message,
        createdAt: new Date(),
      });
      
      try {
        const resendApiKey = import.meta.env.RESEND_API_KEY;
        if (resendApiKey) {
          const { Resend } = await import('resend');
          const resend = new Resend(resendApiKey);
          await resend.emails.send({
            from: 'Guestbook <hello@manthanank.dev>',
            to: 'manthan.ank46@gmail.com', // To admin
            subject: `New Guestbook Entry from ${name}`,
            text: `Name: ${name}\nEmail: ${email || 'N/A'}\nMessage: ${message}`,
          });
        }
      } catch (emailErr) {
        console.warn('Failed to send notification email', emailErr);
      }
      
      success = true;
    }
  } catch (e) {
    console.error(e);
    error = 'Something went wrong. Please try again.';
  }
}

// Fetch all entries
const entries = await db.select().from(GuestbookTable).orderBy(desc(GuestbookTable.createdAt));
---

<BaseLayout title="Guestbook | Manthan Ankolekar" description="Leave a note — I read every message.">
  <section class="section guestbook-hero">
    <div class="container">
      <h1 class="section-title">Guestbook</h1>
      <p class="section-subtitle">Drop a quick hello, feedback, or a question. It will instantly appear below!</p>
    </div>
  </section>

  <section class="container guestbook-section">
    <div class="card form-card">
      <form class="form" id="guestbook-form" method="POST">
        <!-- Honeypot field -->
        <p class="hidden" style="display:none">
          <label>Don’t fill this out if you’re human: <input id="bot-field" name="bot-field" /></label>
        </p>

        <div id="form-error" class="error-banner" style="display:none"></div>
        <div id="form-success" class="success-banner" style="display:none">Thanks for signing the guestbook! Your note has been added below.</div>

        <div class="grid">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" required placeholder="Your name" />
          </div>
          <div class="field">
            <label for="email">Email (optional - won't be public)</label>
            <input id="email" name="email" type="email" placeholder="you@email.com" />
          </div>
        </div>

        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="4" required placeholder="Write your note..."></textarea>
        </div>

        <button class="btn btn-primary btn-magnetic" type="submit" id="guestbook-submit">
          Sign guestbook
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
        </button>
      </form>
    </div>

    <div class="guestbook-entries">
      <h2 class="entries-title">Recent Notes (<span id="entries-count">{entries.length}</span>)</h2>
      <div id="entries-empty" class="empty-state" style={entries.length > 0 ? "display:none;" : ""}>No notes yet. Be the first to sign!</div>
      <div class="entries-grid" id="entries-grid">
        {entries.map(entry => (
          <div class="entry-card reveal active">
            <div class="entry-header">
              <strong>{entry.name}</strong>
              <time>{new Date(entry.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            </div>
            <p class="entry-message">{entry.message}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import confetti from 'canvas-confetti';

  function initGuestbook() {
    const form = document.getElementById('guestbook-form') as HTMLFormElement;
    if (!form) return;

    const nameInput = document.getElementById('name') as HTMLInputElement;
    const emailInput = document.getElementById('email') as HTMLInputElement;
    const msgInput = document.getElementById('message') as HTMLTextAreaElement;
    const botInput = document.getElementById('bot-field') as HTMLInputElement;
    const submitBtn = document.getElementById('guestbook-submit') as HTMLButtonElement;
    const errBanner = document.getElementById('form-error') as HTMLDivElement;
    const succBanner = document.getElementById('form-success') as HTMLDivElement;
    const entriesGrid = document.getElementById('entries-grid') as HTMLDivElement;
    const entriesCount = document.getElementById('entries-count') as HTMLSpanElement;
    const emptyState = document.getElementById('entries-empty') as HTMLDivElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      errBanner.style.display = 'none';
      succBanner.style.display = 'none';

      const name = nameInput.value.trim();
      const email = emailInput.value.trim();
      const message = msgInput.value.trim();
      const botField = botInput ? botInput.value : '';

      if (!name || !message) {
        errBanner.textContent = 'Name and message are required.';
        errBanner.style.display = 'block';
        return;
      }

      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Signing...';

      try {
        const res = await fetch('/api/guestbook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, message, 'bot-field': botField }),
        });

        const data = await res.json();

        if (res.ok && data.success) {
          confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 }
          });

          msgInput.value = '';
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Sign guestbook <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';

          succBanner.style.display = 'block';
          setTimeout(() => {
            succBanner.style.display = 'none';
          }, 6000);

          const currentCount = parseInt(entriesCount.textContent || '0', 10);
          entriesCount.textContent = (currentCount + 1).toString();

          if (emptyState) emptyState.style.display = 'none';

          const entryDate = new Date(data.entry.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
          const newCard = document.createElement('div');
          newCard.className = 'entry-card reveal active';
          newCard.style.opacity = '0';
          newCard.style.transform = 'translateY(20px)';
          newCard.innerHTML = `
            <div class="entry-header">
              <strong>${data.entry.name}</strong>
              <time>${entryDate}</time>
            </div>
            <p class="entry-message">${data.entry.message}</p>
          `;
          
          if (entriesGrid) {
            entriesGrid.insertBefore(newCard, entriesGrid.firstChild);
            requestAnimationFrame(() => {
              newCard.style.transition = 'all 0.5s ease';
              newCard.style.opacity = '1';
              newCard.style.transform = 'translateY(0)';
            });
          }
        } else {
          errBanner.textContent = data.error || 'Something went wrong. Please try again.';
          errBanner.style.display = 'block';
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Sign guestbook <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
        }
      } catch (err) {
        errBanner.textContent = 'Failed to connect. Please check your connection and try again.';
        errBanner.style.display = 'block';
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'Sign guestbook <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>';
      }
    });
  }

  initGuestbook();
  document.addEventListener('astro:after-swap', initGuestbook);
</script>

<style>
  .guestbook-hero {
    padding-top: 8rem;
    padding-bottom: 0;
  }

  .guestbook-section {
    padding-bottom: 5rem;
    max-width: 900px;
  }

  .card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .form-card {
    margin-bottom: 4rem;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .field input,
  .field textarea {
    padding: 0.75rem 1rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    transition: border-color var(--transition);
    outline: none;
    resize: vertical;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
  }

  .error-banner {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  .success-banner {
    background: rgba(34, 197, 94, 0.1);
    color: #22c55e;
    border: 1px solid rgba(34, 197, 94, 0.2);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }

  .success-message {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--color-text);
  }

  .success-icon {
    color: #22c55e;
    margin-bottom: 1rem;
  }

  .success-message h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .success-message p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  /* Entries Styles */
  .guestbook-entries {
    margin-top: 2rem;
  }

  .entries-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 2rem;
    color: var(--color-text);
  }

  .empty-state {
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
    padding: 3rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    border: 1px dashed var(--color-border);
  }

  .entries-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .entry-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    transition: transform var(--transition);
  }

  .entry-card:hover {
    transform: translateX(5px);
    border-color: rgba(0, 212, 255, 0.2);
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .entry-header strong {
    font-size: 1.1rem;
    color: var(--color-text);
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .entry-header time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .entry-message {
    color: var(--color-text-muted);
    line-height: 1.6;
    white-space: pre-wrap;
  }

  @media (max-width: 768px) {
    .guestbook-hero {
      padding-top: 6rem;
    }
    .card {
      padding: 1.25rem;
    }
    .grid {
      grid-template-columns: 1fr;
    }
    .entry-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>

