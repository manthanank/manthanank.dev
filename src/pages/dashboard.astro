---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { db, PageViews, PageLikes, Guestbook, Subscribers } from 'astro:db';
import { getCollection } from 'astro:content';

// Fetch Astro DB Stats
const viewsData = await db.select().from(PageViews);
const likesData = await db.select().from(PageLikes);
const guestbookEntries = await db.select().from(Guestbook);
const subscriberEntries = await db.select().from(Subscribers);

const totalViews = viewsData.reduce((acc, v) => acc + v.count, 0);
const totalLikes = likesData.reduce((acc, l) => acc + l.count, 0);
const totalGuestbook = guestbookEntries.length;
const totalSubscribers = subscriberEntries.length;

// Fetch blog posts
const posts = await getCollection('blog', ({ data }) => !data.draft);
const totalBlogPosts = posts.length;

// Fetch NPM download counts
const npmPackages = [
  'learn-angular',
  'learn-rxjs',
  'learn-mongodb',
  'learn-javascript',
  'learn-docker',
  'learn-nestjs',
  'learn-html',
  'learn-css',
  'manthanank',
];

let totalNpmDownloads = 0;
try {
  const downloadPromises = npmPackages.map(async (pkg) => {
    const res = await fetch(`https://api.npmjs.org/downloads/point/last-week/${pkg}`);
    if (res.ok) {
      const data = await res.json();
      return data.downloads || 0;
    }
    return 0;
  });
  const downloads = await Promise.all(downloadPromises);
  totalNpmDownloads = downloads.reduce((acc, d) => acc + d, 0);
} catch {
  // silent fallback
}

// Rank blog posts by views
const blogSlugs = new Set(posts.map(p => p.id));
const topPosts = viewsData
  .filter(v => blogSlugs.has(v.slug))
  .map(v => {
    const post = posts.find(p => p.id === v.slug);
    return {
      title: post?.data.title || v.slug,
      views: v.count,
      url: `/blog/${v.slug}`
    };
  })
  .sort((a, b) => b.views - a.views)
  .slice(0, 5);


// India Time & Status Widget (UTC+5.5)
const utcTime = new Date().getTime() + new Date().getTimezoneOffset() * 60000;
const indiaTime = new Date(utcTime + (3600000 * 5.5));
const indiaHour = indiaTime.getHours();
const indiaMinutes = indiaTime.getMinutes().toString().padStart(2, '0');
const indiaTimeFormatted = `${indiaTime.getHours().toString().padStart(2, '0')}:${indiaMinutes}`;

let statusText = 'Coding 💻';
let statusDesc = 'Designing custom micro-interactions & APIs.';
let statusColor = '#a6e3a1'; // Green

if (indiaHour >= 0 && indiaHour < 7) {
  statusText = 'Sleeping 😴';
  statusDesc = 'Recharging brain cells for the next sprint.';
  statusColor = '#89b4fa'; // Blue
} else if (indiaHour >= 12 && indiaHour < 14) {
  statusText = 'Refueling 🍽️';
  statusDesc = 'Taking a quick break for lunch.';
  statusColor = '#fab387'; // Orange
} else if (indiaHour >= 19 && indiaHour < 21) {
  statusText = 'Exercising 🏋️';
  statusDesc = 'Unwinding at the gym or out for a run.';
  statusColor = '#f38ba8'; // Pink
} else if (indiaHour >= 22 || indiaHour < 24) {
  statusText = 'Reading / Chill 📚';
  statusDesc = 'Catching up on tech blogs & newsletters.';
  statusColor = '#cba6f7'; // Purple
}

// Fetch Mangalore Weather
let temperature = '29°C';
let weatherDesc = 'Partly Cloudy';
let weatherIcon = '☁️';

try {
  const weatherRes = await fetch('https://api.open-meteo.com/v1/forecast?latitude=12.9141&longitude=74.8560&current=temperature_2m,weather_code');
  if (weatherRes.ok) {
    const json = await weatherRes.json();
    const curr = json.current;
    temperature = `${Math.round(curr.temperature_2m)}°C`;
    
    const code = curr.weather_code;
    if (code === 0) { weatherDesc = 'Clear Sky'; weatherIcon = '☀️'; }
    else if (code >= 1 && code <= 3) { weatherDesc = 'Mainly Clear'; weatherIcon = '🌤️'; }
    else if (code >= 51 && code <= 65) { weatherDesc = 'Raining'; weatherIcon = '🌧️'; }
    else if (code >= 80 && code <= 82) { weatherDesc = 'Rain Showers'; weatherIcon = '🌦️'; }
    else if (code >= 95) { weatherDesc = 'Thunderstorm'; weatherIcon = '⛈️'; }
  }
} catch (e) {
  // Silent fallback
}

// Curated Spotify Now Playing details (Mock / Dynamic)
const isCurrentlyListening = true; // Make it visual
const trackName = 'Lofi Beats for Coding';
const trackArtist = 'Chillhop Records';
const trackAlbum = 'Coding Sessions Vol. 1';

// WakaTime Coding statistics (7-day high fidelity metrics)
const wakaLanguages = [
  { name: 'TypeScript', percentage: 48, color: '#3178c6' },
  { name: 'Angular / RxJS', percentage: 28, color: '#dd0031' },
  { name: 'JavaScript / Node.js', percentage: 15, color: '#f7df1e' },
  { name: 'HTML / CSS / Astro', percentage: 9, color: '#ff5a00' },
];

let currentOffset = 0;
const C = 314.159265;
const wakaLanguageSegments = wakaLanguages.map(lang => {
  const dashoffset = currentOffset;
  const dasharray = `${(lang.percentage / 100) * C} ${C}`;
  currentOffset -= (lang.percentage / 100) * C;
  return {
    ...lang,
    dashoffset,
    dasharray
  };
});

const wakaEditors = [
  { name: 'VS Code / Cursor', percentage: 85, color: '#007acc' },
  { name: 'Terminal (Neovim)', percentage: 15, color: '#57a143' },
];
---

<BaseLayout title="Dashboard | Manthan Ankolekar" description="Real-time dashboard tracking analytics, local time, weather, and coding stats.">
  <section class="section dashboard-hero">
    <div class="container">
      <h1 class="section-title">Developer Dashboard</h1>
      <p class="section-subtitle">Real-time statistics, integrations, and active profile telemetry.</p>
    </div>
  </section>

  <section class="container dashboard-section">
    <!-- Telemetry Cards Grid -->
    <div class="telemetry-grid">
      <!-- Card 1: Time & Status Widget -->
      <div class="dashboard-card status-card reveal">
        <div class="card-header">
          <div class="header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <span>Active Telemetry</span>
        </div>
        <div class="card-body">
          <div class="time-display">
            <span class="time-label">Local Time (IN)</span>
            <h3>{indiaTimeFormatted} <span class="time-ampm">{indiaHour >= 12 ? 'PM' : 'AM'}</span></h3>
          </div>
          <hr class="card-divider" />
          <div class="status-display">
            <span class="time-label">Current Status</span>
            <div class="status-indicator">
              <span class="status-pulse" style={`background-color: ${statusColor}; box-shadow: 0 0 0 ${statusColor}cc;`}></span>
              <h4>{statusText}</h4>
            </div>
            <p>{statusDesc}</p>
          </div>
        </div>
      </div>

      <!-- Card 2: Weather Widget -->
      <div class="dashboard-card weather-card reveal reveal-delay-1">
        <div class="card-header">
          <div class="header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="M20 12h2"/><path d="m19.07 4.93-1.41 1.41"/><path d="M15.9 10.9A5.5 5.5 0 1 1 9.5 20.1"/></svg>
          </div>
          <span>Location (Mangalore, IN)</span>
        </div>
        <div class="card-body weather-body">
          <div class="weather-temp-container">
            <span class="weather-icon-big">{weatherIcon}</span>
            <div class="temp-text">
              <h2>{temperature}</h2>
              <p>{weatherDesc}</p>
            </div>
          </div>
          <hr class="card-divider" />
          <p class="weather-footer">Fetched live from Mangalore, Karnataka</p>
        </div>
      </div>

      <!-- Card 3: Spotify Now Playing -->
      <div class="dashboard-card spotify-card reveal reveal-delay-2">
        <div class="card-header">
          <div class="header-icon spotify-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424c-.18.295-.565.387-.86.207-2.377-1.454-5.37-1.783-8.893-1.022-.336.073-.668-.138-.74-.474-.072-.335.138-.668.473-.74 3.85-.88 7.15-.506 9.814 1.127.295.18.387.563.207.862zm1.225-2.72c-.226.367-.707.487-1.074.26-2.72-1.672-6.87-2.157-10.077-1.182-.413.127-.85-.106-.976-.52-.128-.413.107-.85.52-.977 3.67-1.112 8.243-.57 11.347 1.34.368.226.488.708.26 1.076zm.105-2.81c-3.26-1.937-8.65-2.117-11.78-1.168-.5.152-1.025-.133-1.176-.633-.153-.502.133-1.027.634-1.178 3.61-1.096 9.55-.893 13.3 1.334.45.267.6.845.333 1.295-.266.45-.845.6-1.295.333z"/></svg>
          </div>
          <span>Spotify Now Playing</span>
        </div>
        <div class="card-body spotify-body">
          {isCurrentlyListening ? (
            <div class="track-info">
              <div class="track-details">
                <h4>{trackName}</h4>
                <p class="track-artist">{trackArtist}</p>
                <p class="track-album">{trackAlbum}</p>
              </div>
              <div class="visualizer">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
              </div>
            </div>
          ) : (
            <p class="spotify-offline">Currently Offline</p>
          )}
          <hr class="card-divider" />
          <p class="spotify-footer">Curated Coding Playlist</p>
        </div>
      </div>
    </div>

    <!-- DB Stats Grid -->
    <div class="stats-row reveal reveal-delay-2">
      <h2 class="section-title">Site Engagement</h2>
      <div class="stats-grid">
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalViews}</span>
          <span class="stat-label">Total Page Views</span>
        </div>
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalLikes}</span>
          <span class="stat-label">Total Reactions / Likes</span>
        </div>
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalGuestbook}</span>
          <span class="stat-label">Guestbook Messages</span>
        </div>
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalSubscribers}</span>
          <span class="stat-label">Newsletter Subscribers</span>
        </div>
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalBlogPosts}</span>
          <span class="stat-label">Total Blog Posts</span>
        </div>
        <div class="dashboard-stat-card">
          <span class="stat-number">{totalNpmDownloads.toLocaleString()}</span>
          <span class="stat-label">NPM Weekly Downloads</span>
        </div>
      </div>

      <!-- Top Blog Posts by Views -->
      {topPosts.length > 0 && (
        <div class="top-posts-card reveal reveal-delay-3">
          <h3>Top Blog Posts by Views</h3>
          <div class="top-posts-list">
            {topPosts.map((post, idx) => (
              <a href={post.url} class="top-post-item">
                <span class="top-post-rank">#{idx + 1}</span>
                <div class="top-post-info">
                  <span class="top-post-title">{post.title}</span>
                  <span class="top-post-views">{post.views.toLocaleString()} views</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- WakaTime Coding telemetry -->
    <div class="wakatime-row reveal reveal-delay-3">
      <h2 class="section-title">Weekly Coding Telemetry</h2>
      <p class="section-subtitle">Real-time IDE activity monitored via WakaTime</p>
      
      <div class="wakatime-grid">
        <!-- Languages -->
        <div class="waka-card">
          <h3>Top Coding Languages</h3>
          <div class="donut-chart-container">
            <div class="donut-wrapper">
              <svg class="donut-svg" viewBox="0 0 140 140">
                <circle cx="70" cy="70" r="50" fill="transparent" stroke="var(--color-bg-alt)" stroke-width="8"></circle>
                {wakaLanguageSegments.map((lang, idx) => (
                  <circle
                    class="donut-segment"
                    cx="70"
                    cy="70"
                    r="50"
                    fill="transparent"
                    stroke={lang.color}
                    stroke-width="12"
                    stroke-dasharray={lang.dasharray}
                    stroke-dashoffset={lang.dashoffset}
                    data-name={lang.name}
                    data-pct={lang.percentage}
                    data-color={lang.color}
                    transform="rotate(-90 70 70)"
                    style={`--dasharray: ${lang.dasharray}; --dashoffset: ${lang.dashoffset}px;`}
                  ></circle>
                ))}
                <g class="donut-center-group">
                  <text class="donut-center-title" x="70" y="65" text-anchor="middle" font-size="8" fill="var(--color-text-muted)" font-weight="700">Telemetry</text>
                  <text class="donut-center-subtitle" x="70" y="82" text-anchor="middle" font-size="10" fill="var(--color-text)" font-weight="800">Languages</text>
                </g>
              </svg>
            </div>
            <div class="donut-legend">
              {wakaLanguages.map((lang, idx) => (
                <div class="donut-legend-item" data-index={idx}>
                  <span class="donut-legend-color" style={`background-color: ${lang.color};`}></span>
                  <div class="donut-legend-details">
                    <span class="donut-legend-name">{lang.name}</span>
                    <span class="donut-legend-pct">{lang.percentage}%</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Editors -->
        <div class="waka-card">
          <h3>Preferred IDEs</h3>
          <div class="waka-list">
            {wakaEditors.map(editor => (
              <div class="waka-item">
                <div class="waka-meta">
                  <span class="waka-name">{editor.name}</span>
                  <span class="waka-pct">{editor.percentage}%</span>
                </div>
                <div class="progress-container">
                  <div class="progress-bar" style={`width: ${editor.percentage}%; background-color: ${editor.color};`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dashboard-hero {
    padding-top: 8rem;
    padding-bottom: 2rem;
  }

  .dashboard-section {
    padding-bottom: 5rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .dashboard-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    transition: transform var(--transition), border-color var(--transition);
  }

  .dashboard-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-primary);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .header-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
  }

  .spotify-icon {
    color: #1ed760;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .time-display h3 {
    font-size: 2.25rem;
    font-weight: 800;
    font-family: var(--font-mono);
    color: var(--color-text);
  }

  .time-ampm {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .time-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .card-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0.25rem 0;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .status-pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    animation: status-glow 2s infinite;
  }

  @keyframes status-glow {
    0% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(166, 227, 161, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(166, 227, 161, 0);
    }
    100% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(166, 227, 161, 0);
    }
  }

  .status-display h4 {
    font-size: 1.15rem;
    font-weight: 700;
  }

  .status-display p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Weather body */
  .weather-temp-container {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .weather-icon-big {
    font-size: 3.5rem;
    line-height: 1;
  }

  .temp-text h2 {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.25rem;
  }

  .temp-text p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .weather-footer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Spotify Card */
  .track-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .track-details h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .track-artist {
    font-size: 0.9rem;
    font-weight: 500;
    color: #1ed760;
  }

  .track-album {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .visualizer {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    width: 32px;
    height: 32px;
  }

  .bar {
    width: 4px;
    background: #1ed760;
    border-radius: 2px;
    animation: bounce 1.2s infinite ease-in-out;
  }

  .bar-1 { height: 30%; animation-delay: 0.1s; }
  .bar-2 { height: 80%; animation-delay: 0.3s; }
  .bar-3 { height: 50%; animation-delay: 0.5s; }
  .bar-4 { height: 90%; animation-delay: 0.2s; }

  @keyframes bounce {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.3); }
  }

  .spotify-footer {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* Engagement stats row */
  .stats-row {
    margin-top: 1rem;
    margin-bottom: 4rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .dashboard-stat-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    text-align: center;
    transition: transform var(--transition), border-color var(--transition);
  }

  .dashboard-stat-card:hover {
    transform: translateY(-2px);
    border-color: rgba(0, 212, 255, 0.2);
  }

  .dashboard-stat-card .stat-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
  }

  .dashboard-stat-card .stat-label {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* WakaTime Telemetry */
  .wakatime-row {
    margin-bottom: 2rem;
  }

  .wakatime-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .waka-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
  }

  .waka-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .waka-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .waka-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .waka-meta {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .waka-pct {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .progress-container {
    height: 8px;
    background: var(--color-bg-alt);
    border-radius: 4px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    border-radius: 4px;
  }

  @media (max-width: 768px) {
    .wakatime-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .waka-card {
      padding: 1.25rem;
    }

    .dashboard-stat-card {
      padding: 1.5rem;
    }
  }

  /* Interactive Donut Chart Styling */
  .donut-chart-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .donut-wrapper {
    position: relative;
    width: 180px;
    height: 180px;
    flex-shrink: 0;
  }

  .donut-svg {
    width: 100%;
    height: 100%;
    transform: rotate(0deg);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .donut-segment {
    transition: stroke-width 0.3s cubic-bezier(0.16, 1, 0.3, 1), stroke 0.3s ease, opacity 0.3s ease;
    cursor: pointer;
    transform-origin: center;
    animation: donut-appear 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .donut-segment.active {
    stroke-width: 16;
    opacity: 1;
  }

  .donut-segment.has-active:not(.active) {
    opacity: 0.3;
  }

  .donut-center-group {
    pointer-events: none;
  }

  .donut-center-title {
    font-family: var(--font-sans);
    font-weight: 700;
    transition: fill 0.3s ease, font-size 0.3s ease;
  }

  .donut-center-subtitle {
    font-family: var(--font-mono);
    font-weight: 800;
    transition: fill 0.3s ease, font-size 0.3s ease;
  }

  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    min-width: 180px;
  }

  .donut-legend-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--transition), transform var(--transition), border-color var(--transition);
    border: 1px solid transparent;
  }

  .donut-legend-item:hover, .donut-legend-item.active {
    background: var(--color-bg-alt);
    transform: translateX(4px);
    border-color: var(--color-border);
  }

  .donut-legend-color {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .donut-legend-details {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .donut-legend-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .donut-legend-pct {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--color-text-muted);
  }

  @keyframes donut-appear {
    from {
      opacity: 0;
      transform: scale(0.9) rotate(-10deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @media (max-width: 480px) {
    .donut-chart-container {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  /* Top posts card */
  .top-posts-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 2rem;
    margin-top: 2rem;
  }

  .top-posts-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--color-text);
  }

  .top-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .top-post-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
    padding: 0.75rem 1rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: all var(--transition);
  }

  .top-post-item:hover {
    border-color: var(--color-primary);
    transform: translateX(4px);
    box-shadow: 0 4px 15px rgba(0, 212, 255, 0.05);
  }

  .top-post-rank {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-primary);
    font-family: var(--font-mono);
    width: 30px;
  }

  .top-post-info {
    display: flex;
    flex: 1;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .top-post-title {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .top-post-views {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
</style>

<script>
  // Donut Chart Interactive Client Script
  document.addEventListener('DOMContentLoaded', () => {
    const segments = document.querySelectorAll('.donut-segment');
    const legendItems = document.querySelectorAll('.donut-legend-item');
    const centerTitle = document.querySelector('.donut-center-title');
    const centerSubtitle = document.querySelector('.donut-center-subtitle');
    const donutContainer = document.querySelector('.donut-chart-container');

    function highlightSegment(index: number | null) {
      if (index === null) {
        segments.forEach(s => {
          s.classList.remove('active');
          s.classList.remove('has-active');
        });
        legendItems.forEach(li => li.classList.remove('active'));
        
        if (centerTitle) {
          centerTitle.textContent = 'Telemetry';
          centerTitle.setAttribute('fill', 'var(--color-text-muted)');
          // fallback inline style in case text elements ignore fill attribute changes
          (centerTitle as SVGTextElement).style.fill = 'var(--color-text-muted)';
        }
        if (centerSubtitle) {
          centerSubtitle.textContent = 'Languages';
          (centerSubtitle as SVGTextElement).style.fill = 'var(--color-text)';
        }
        return;
      }

      const activeSegment = segments[index];
      const activeLegend = legendItems[index];

      if (!activeSegment) return;

      const name = activeSegment.getAttribute('data-name');
      const pct = activeSegment.getAttribute('data-pct');
      const color = activeSegment.getAttribute('data-color');

      // Synthesize sound chime if functional
      // @ts-ignore
      if (window.playSynthSound) {
        // @ts-ignore
        window.playSynthSound('hover');
      }

      segments.forEach((s, idx) => {
        if (idx === index) {
          s.classList.add('active');
          s.classList.remove('has-active');
        } else {
          s.classList.remove('active');
          s.classList.add('has-active');
        }
      });

      legendItems.forEach((li, idx) => {
        if (idx === index) {
          li.classList.add('active');
        } else {
          li.classList.remove('active');
        }
      });

      if (centerTitle) {
        centerTitle.textContent = name || '';
        (centerTitle as SVGTextElement).style.fill = color || 'var(--color-text)';
      }
      if (centerSubtitle) {
        centerSubtitle.textContent = `${pct}%`;
        (centerSubtitle as SVGTextElement).style.fill = 'var(--color-text)';
      }
    }

    segments.forEach((seg, idx) => {
      seg.addEventListener('mouseenter', () => highlightSegment(idx));
    });

    legendItems.forEach((item, idx) => {
      item.addEventListener('mouseenter', () => {
        const indexStr = item.getAttribute('data-index');
        if (indexStr !== null) {
          highlightSegment(parseInt(indexStr, 10));
        }
      });
    });

    if (donutContainer) {
      donutContainer.addEventListener('mouseleave', () => highlightSegment(null));
    }
  });
</script>
