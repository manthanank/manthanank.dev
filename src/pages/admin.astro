---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { db, Guestbook, Subscribers, desc } from 'astro:db';

const adminPassword = import.meta.env.ADMIN_PASSWORD || 'admin123';
const cookies = Astro.cookies;
let hasSession = cookies.get('admin_session')?.value === adminPassword;
let error = '';

// Handle logout
if (Astro.url.searchParams.has('logout')) {
  Astro.cookies.delete('admin_session', { path: '/' });
  return Astro.redirect('/admin');
}

// Handle login
if (Astro.request.method === 'POST') {
  try {
    const data = await Astro.request.formData();
    const passcode = data.get('passcode')?.toString();
    
    if (passcode === adminPassword) {
      Astro.cookies.set('admin_session', adminPassword, { path: '/', httpOnly: true, secure: true });
      hasSession = true;
      return Astro.redirect('/admin');
    } else {
      error = 'Invalid passcode. Please try again.';
    }
  } catch (e) {
    error = 'Something went wrong.';
  }
}

// Only fetch DB details if logged in
let entries: any[] = [];
let subs: any[] = [];

if (hasSession) {
  entries = await db.select().from(Guestbook).orderBy(desc(Guestbook.createdAt));
  subs = await db.select().from(Subscribers).orderBy(desc(Subscribers.createdAt));
}
---

<BaseLayout title="Admin Portal | Manthan Ankolekar" description="Secure database administration panel.">
  <section class="section admin-hero">
    <div class="container">
      <h1 class="section-title">Admin Dashboard</h1>
      <p class="section-subtitle">Secure moderation and database telemetry portal.</p>
    </div>
  </section>

  <section class="container admin-section">
    {!hasSession ? (
      <!-- Lock Screen -->
      <div class="card lock-card reveal">
        <div class="lock-header">
          <svg class="lock-icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <h2>Console Locked</h2>
          <p>Please enter administrative passcode to decrypt telemetry data.</p>
        </div>
        
        <form class="form" method="POST">
          {error && <div class="error-banner">{error}</div>}
          <div class="field">
            <label for="passcode">Administrative Password</label>
            <input id="passcode" name="passcode" type="password" required placeholder="••••••••" autofocus />
          </div>
          <button class="btn btn-primary btn-magnetic" type="submit">Unlock Console</button>
        </form>
      </div>
    ) : (
      <!-- Admin Workspace -->
      <div class="admin-workspace">
        <div class="workspace-header">
          <div class="session-info">
            <span class="active-badge"></span>
            <span>Console Session Decrypted</span>
          </div>
          <a href="?logout" class="btn-logout">Lock Session</a>
        </div>

        <div class="workspace-tabs">
          <div class="tabs-buttons">
            <button class="tab-btn active" data-panel="guestbook-panel">Guestbook Moderation ({entries.length})</button>
            <button class="tab-btn" data-panel="subscribers-panel">Newsletter Subscribers ({subs.length})</button>
          </div>

          <div class="tabs-panels">
            <!-- Panel 1: Guestbook Moderation -->
            <div class="tab-panel active" id="guestbook-panel">
              {entries.length === 0 ? (
                <p class="empty-state">No guestbook entries found.</p>
              ) : (
                <div class="moderation-list">
                  {entries.map(entry => (
                    <div class="mod-card" id={`entry-${entry.id}`}>
                      <div class="mod-header">
                        <div class="mod-meta">
                          <strong>{entry.name}</strong>
                          <span class="mod-email">{entry.email || 'No email provided'}</span>
                        </div>
                        <button class="btn-delete" data-id={entry.id}>
                          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                          Delete
                        </button>
                      </div>
                      <p class="mod-message">"{entry.message}"</p>
                      <time class="mod-time">{new Date(entry.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}</time>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <!-- Panel 2: Newsletter Subscribers -->
            <div class="tab-panel" id="subscribers-panel">
              {subs.length === 0 ? (
                <p class="empty-state">No subscribers found.</p>
              ) : (
                <div class="subscribers-table-wrapper">
                  <table class="subs-table">
                    <thead>
                      <tr>
                        <th>Email Address</th>
                        <th>Subscribed Date</th>
                      </tr>
                    </thead>
                    <tbody>
                      {subs.map(sub => (
                        <tr>
                          <td class="sub-email">{sub.email}</td>
                          <td class="sub-date">{new Date(sub.createdAt).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' })}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<script define:vars={{ adminPassword }}>
  function initAdmin() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    // Handle Tabs
    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        tabPanels.forEach(p => p.classList.remove('active'));

        btn.classList.add('active');
        const target = btn.getAttribute('data-panel');
        const panel = document.getElementById(target);
        if (panel) panel.classList.add('active');
      });
    });

    // Handle AJAX deletion of guestbook items
    const deleteBtns = document.querySelectorAll('.btn-delete');
    deleteBtns.forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!id) return;

        if (!confirm('Are you sure you want to delete this guestbook entry permanently?')) {
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Deleting...';

        try {
          const res = await fetch('/api/admin/delete-guestbook', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, passcode: adminPassword }),
          });

          if (res.ok) {
            // Fade out and remove element
            const card = document.getElementById(`entry-${id}`);
            if (card) {
              card.style.transition = 'all 0.5s ease';
              card.style.opacity = '0';
              card.style.transform = 'translateY(-10px)';
              setTimeout(() => card.remove(), 500);
            }
          } else {
            alert('Failed to delete item.');
            btn.disabled = false;
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg> Delete`;
          }
        } catch (err) {
          alert('Failed to connect to delete endpoint.');
          btn.disabled = false;
        }
      });
    });
  }

  // Run on initial load
  initAdmin();

  // Run on Astro View Transition swap
  document.addEventListener('astro:after-swap', initAdmin);
</script>

<style>
  .admin-hero {
    padding-top: 8rem;
    padding-bottom: 2rem;
  }

  .admin-section {
    padding-bottom: 5rem;
    max-width: 900px;
  }

  /* Lock Screen */
  .lock-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 20px;
    padding: 3rem 2rem;
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
  }

  .lock-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .lock-icon {
    color: var(--color-primary);
  }

  .lock-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .lock-header p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-align: left;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-text-muted);
  }

  .field input {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--transition);
  }

  .field input:focus {
    border-color: var(--color-primary);
  }

  .error-banner {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
  }

  /* Admin Workspace */
  .admin-workspace {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .workspace-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
    border-radius: 12px;
  }

  .session-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .active-badge {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
  }

  .btn-logout {
    font-size: 0.82rem;
    font-weight: 700;
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    transition: all var(--transition);
  }

  .btn-logout:hover {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
  }

  /* Workspace tabs */
  .workspace-tabs {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
  }

  .tabs-buttons {
    display: flex;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .tabs-buttons .tab-btn {
    flex: 1;
    padding: 1rem;
    font-family: inherit;
    font-weight: 600;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all var(--transition);
  }

  .tabs-buttons .tab-btn:hover {
    color: var(--color-primary);
  }

  .tabs-buttons .tab-btn.active {
    color: var(--color-primary);
    background: var(--color-bg-card);
    border-bottom-color: var(--color-primary);
  }

  .tabs-panels {
    padding: 2rem;
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.active {
    display: block;
  }

  /* Moderation list card */
  .moderation-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .mod-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .mod-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .mod-meta {
    display: flex;
    flex-direction: column;
  }

  .mod-meta strong {
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .mod-email {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .btn-delete {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.2);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-family: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition);
  }

  .btn-delete:hover {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
  }

  .mod-message {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
    white-space: pre-wrap;
  }

  .mod-time {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  /* Subscribers table */
  .subscribers-table-wrapper {
    overflow-x: auto;
  }

  .subs-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .subs-table th,
  .subs-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .subs-table th {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-primary);
  }

  .subs-table td {
    font-size: 0.95rem;
  }

  .sub-email {
    font-weight: 600;
    color: var(--color-text);
  }

  .sub-date {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    background: var(--color-bg-alt);
    border-radius: 12px;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .lock-card {
      padding: 2rem 1.25rem;
    }
    .mod-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
    .tabs-panels {
      padding: 1.25rem;
    }
  }
</style>
