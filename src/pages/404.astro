---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404: Page Not Found | Manthan Ankolekar">
  <div class="error-page">
    <div class="container grid-container">
      <!-- Error Message Panel -->
      <div class="error-content reveal">
        <div class="error-visual">
          <span class="error-code">404</span>
          <div class="error-circle"></div>
        </div>
        <h1>Lost in Space?</h1>
        <p>
          The page you are looking for has vanished. While we search for it, why not set a new high score?
        </p>
        <div class="cta-row">
          <a href="/" class="btn btn-primary">Return Home</a>
        </div>
      </div>

      <!-- Snake Game Panel -->
      <div class="game-container reveal reveal-delay-2">
        <div class="game-card">
          <div class="game-header">
            <h3>Retro Arcade: Snake</h3>
            <div class="scores">
              <span>Score: <strong id="score">0</strong></span>
              <span>High: <strong id="high-score">0</strong></span>
            </div>
          </div>
          
          <div class="canvas-wrapper">
            <canvas id="snake-canvas" width="400" height="400"></canvas>
            
            <!-- Game Overlay -->
            <div class="game-overlay" id="game-overlay">
              <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="game-icon"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              <h4>Press Space or Click to Play</h4>
              <p>Use Arrow keys (or WASD) to navigate</p>
              <button class="btn btn-primary" id="btn-start-game">Start Arcade</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initSnakeGame() {
    const canvas = document.getElementById('snake-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    const overlay = document.getElementById('game-overlay') as HTMLDivElement;
    const startBtn = document.getElementById('btn-start-game');
    const scoreEl = document.getElementById('score');
    const highEl = document.getElementById('high-score');

    if (!ctx || !overlay || !startBtn || !scoreEl || !highEl) return;

    const gridSize = 20;
    const tileCount = canvas.width / gridSize;
    
    let snake: {x: number, y: number}[] = [];
    let food = {x: 5, y: 5};
    let dx = gridSize;
    let dy = 0;
    let score = 0;
    let highScore = parseInt(localStorage.getItem('snake_high_score') || '0', 10);
    let gameInterval: any = null;
    let isPlaying = false;
    let speed = 100;

    highEl.textContent = highScore.toString();

    function startGame() {
      overlay.style.display = 'none';
      snake = [
        {x: gridSize * 5, y: gridSize * 10},
        {x: gridSize * 4, y: gridSize * 10},
        {x: gridSize * 3, y: gridSize * 10},
      ];
      dx = gridSize;
      dy = 0;
      score = 0;
      scoreEl!.textContent = score.toString();
      isPlaying = true;
      spawnFood();
      
      if (gameInterval) clearInterval(gameInterval);
      gameInterval = setInterval(update, speed);
    }

    function spawnFood() {
      food = {
        x: Math.floor(Math.random() * tileCount) * gridSize,
        y: Math.floor(Math.random() * tileCount) * gridSize,
      };
      
      // Don't spawn food on top of snake
      for (let part of snake) {
        if (part.x === food.x && part.y === food.y) {
          spawnFood();
          break;
        }
      }
    }

    function update() {
      if (!isPlaying) return;

      // Move head
      const head = {x: snake[0].x + dx, y: snake[0].y + dy};

      // Wrap-around bounds check
      if (head.x < 0) head.x = canvas.width - gridSize;
      if (head.x >= canvas.width) head.x = 0;
      if (head.y < 0) head.y = canvas.height - gridSize;
      if (head.y >= canvas.height) head.y = 0;

      // Self collision check
      for (let i = 0; i < snake.length; i++) {
        if (snake[i].x === head.x && snake[i].y === head.y) {
          gameOver();
          return;
        }
      }

      snake.unshift(head);

      // Food collision
      if (head.x === food.x && head.y === food.y) {
        score += 10;
        scoreEl!.textContent = score.toString();
        if (score > highScore) {
          highScore = score;
          highEl!.textContent = highScore.toString();
          localStorage.setItem('snake_high_score', highScore.toString());
        }
        spawnFood();
      } else {
        snake.pop();
      }

      draw();
    }

    function draw() {
      // Clear
      ctx!.fillStyle = '#0f172a';
      ctx!.fillRect(0, 0, canvas.width, canvas.height);

      // Grid background details (faint)
      ctx!.strokeStyle = 'rgba(255, 255, 255, 0.02)';
      for (let i = 0; i < tileCount; i++) {
        ctx!.beginPath();
        ctx!.moveTo(i * gridSize, 0);
        ctx!.lineTo(i * gridSize, canvas.height);
        ctx!.stroke();
        
        ctx!.beginPath();
        ctx!.moveTo(0, i * gridSize);
        ctx!.lineTo(canvas.width, i * gridSize);
        ctx!.stroke();
      }

      // Draw food (Neon Red/Pink pulse)
      ctx!.fillStyle = '#f38ba8';
      ctx!.shadowBlur = 10;
      ctx!.shadowColor = '#f38ba8';
      ctx!.fillRect(food.x + 2, food.y + 2, gridSize - 4, gridSize - 4);
      
      // Draw snake (Gradient primary-to-accent neon)
      ctx!.shadowBlur = 8;
      snake.forEach((part, index) => {
        // Head has distinct color
        if (index === 0) {
          ctx!.fillStyle = '#00d4ff';
          ctx!.shadowColor = '#00d4ff';
        } else {
          ctx!.fillStyle = '#7c3aed';
          ctx!.shadowColor = '#7c3aed';
        }
        ctx!.fillRect(part.x + 1, part.y + 1, gridSize - 2, gridSize - 2);
      });
      
      // Reset shadows
      ctx!.shadowBlur = 0;
    }

    function gameOver() {
      isPlaying = false;
      clearInterval(gameInterval);
      overlay.style.display = 'flex';
      overlay.querySelector('h4')!.textContent = `Game Over! Score: ${score}`;
      overlay.querySelector('p')!.textContent = 'Click to insert token and try again.';
      overlay.querySelector('button')!.textContent = 'Play Again';
    }

    // Keyboard bindings
    window.addEventListener('keydown', (e) => {
      if (!isPlaying) {
        if (e.key === ' ' || e.key === 'Enter') {
          e.preventDefault();
          startGame();
        }
        return;
      }

      if (e.key === 'ArrowUp' || e.key.toLowerCase() === 'w') {
        e.preventDefault();
        if (dy === 0) { dx = 0; dy = -gridSize; }
      } else if (e.key === 'ArrowDown' || e.key.toLowerCase() === 's') {
        e.preventDefault();
        if (dy === 0) { dx = 0; dy = gridSize; }
      } else if (e.key === 'ArrowLeft' || e.key.toLowerCase() === 'a') {
        e.preventDefault();
        if (dx === 0) { dx = -gridSize; dy = 0; }
      } else if (e.key === 'ArrowRight' || e.key.toLowerCase() === 'd') {
        e.preventDefault();
        if (dx === 0) { dx = gridSize; dy = 0; }
      }
    });

    startBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      startGame();
    });

    overlay.addEventListener('click', (e) => {
      e.stopPropagation();
      startGame();
    });

    // Initial paint background
    ctx.fillStyle = '#0f172a';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
  }

  // Setup game
  initSnakeGame();
  
  // Support Astro Page swaps
  document.addEventListener('astro:after-swap', initSnakeGame);
</script>

<style>
  .error-page {
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 100px;
    padding-bottom: 3rem;
  }

  .grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .error-content {
    max-width: 500px;
  }

  .error-visual {
    position: relative;
    margin-bottom: 1.5rem;
    display: inline-block;
  }

  .error-code {
    font-size: clamp(5rem, 12vw, 8rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    z-index: 2;
  }

  .error-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 150%;
    height: 150%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.1) 0%, rgba(0, 212, 255, 0) 70%);
    z-index: 1;
    pointer-events: none;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  /* Game Card Box */
  .game-container {
    max-width: 440px;
    width: 100%;
    justify-self: center;
  }

  .game-card {
    background: #1e293b; /* Force darker retro card background */
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    color: #fff;
  }

  .game-header h3 {
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .scores {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .scores strong {
    color: var(--color-primary);
  }

  .canvas-wrapper {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  #snake-canvas {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    background: #0f172a;
  }

  .game-overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #fff;
    padding: 2rem;
    text-align: center;
    cursor: pointer;
  }

  .game-icon {
    color: var(--color-primary);
    margin-bottom: 1rem;
    animation: start-pulse 1.5s infinite;
  }

  @keyframes start-pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  .game-overlay h4 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .game-overlay p {
    font-size: 0.8rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }

  @media (max-width: 768px) {
    .grid-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      text-align: center;
    }

    .error-content {
      margin: 0 auto;
    }

    .game-container {
      max-width: 360px;
    }
  }
</style>
