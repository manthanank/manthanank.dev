---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkillBadge from '../components/SkillBadge.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { isExcludedRepo } from '../data/excluded-repos';
import { db, PageViews, PageLikes } from 'astro:db';

const skills = [
  'Next.js', 'React', 'Angular', 'RxJS', 'Tailwind CSS', 'TypeScript',
  'JavaScript', 'Python', 'Node.js', 'Express.js', 'Flask', 'RabbitMQ',
  'PostgreSQL', 'MongoDB', 'MySQL', 'Redis', 'Supabase', 'Firebase',
  'LLMs', 'AWS', 'GCP', 'Docker'
];

const workProjects = [
  {
    title: 'Handoff',
    description: 'Test-drive and service-pickup damage proof for automotive dealerships: mobile-first vehicle condition capture, loaner tracking, and dispute-proof claim packets.',
    tags: ['TypeScript', 'PostgreSQL', 'Supabase', 'Next.js', 'Automotive'],
    live: 'https://handoff.3-130-85-220.sslip.io/',
    company: 'Tech Ventures Group',
    slug: 'handoff',
  },
  {
    title: 'CarePulse',
    description: '20-second patient check-ins and remote patient monitoring for clinics: daily check-ins, alert triage queue, and automated CMS CPT billing time tracking.',
    tags: ['TypeScript', 'PostgreSQL', 'Supabase', 'Healthcare', 'Next.js'],
    live: 'https://carepulse.3-130-85-220.sslip.io/',
    company: 'Tech Ventures Group',
    slug: 'carepulse',
  },
  {
    title: 'ReconOS',
    description: 'Reconditioning software for used-car dealerships: the shop Kanban board, stage SLA timers, legacy DMS migration engine, and self-hosted Docker/EC2 infrastructure.',
    tags: ['Next.js', 'TypeScript', 'Supabase', 'PostgreSQL', 'Docker', 'AWS'],
    company: 'Tech Ventures Group',
    slug: 'reconos',
  },
  {
    title: 'DealerDash AI',
    description: 'AI-powered, human-driven dealership KPI dashboard and operational intelligence platform with predictive scoring, expense analysis, and industry benchmark analytics.',
    tags: ['Next.js', 'TypeScript', 'AI / ML', 'Automotive', 'Analytics'],
    live: 'https://dealerdash.ai/',
    company: 'Tech Ventures Group',
    slug: 'dealerdash',
  },
];

const landingProjects = [
  {
    title: 'CoverDrive Cricket Academy',
    description: 'Elite cricket performance platform featuring interactive bat swing telemetry and 22-yard pitch simulation.',
    tags: ['Next.js', 'React', 'Tailwind CSS', 'Framer Motion', 'SportsTech'],
    github: 'https://github.com/manthanank/coverdrive-cricket',
    live: 'https://coverdrive-cricket.vercel.app',
    slug: 'coverdrive-cricket',
  },
  {
    title: 'Nexus Agents',
    description: 'Autonomous multi-agent AI orchestration and deterministic governance platform with sub-100ms MCP tool calling.',
    tags: ['Next.js', 'React', 'Framer Motion', 'AI Agents', 'MCP'],
    github: 'https://github.com/manthanank/nexus-landing',
    live: 'https://nexus-landing-app.vercel.app',
    slug: 'nexus-landing',
  },
  {
    title: 'Aegis Zero-Trust',
    description: 'Cloud security posture management and zero-trust runtime policy compiler engine.',
    tags: ['Next.js', 'React', 'Tailwind CSS', 'Cybersecurity', 'Zero-Trust'],
    github: 'https://github.com/manthanank/aegis-landing',
    live: 'https://aegis-landing-app.vercel.app',
    slug: 'aegis-landing',
  },
  {
    title: 'Trace Observability',
    description: 'Sub-millisecond OpenTelemetry distributed span ingestion powered by eBPF kernel probes and ClickHouse.',
    tags: ['Next.js', 'React', 'eBPF', 'Observability', 'OpenTelemetry'],
    github: 'https://github.com/manthanank/trace-landing',
    live: 'https://trace-landing-app.vercel.app',
    slug: 'trace-landing',
  },
  {
    title: 'FreshCart Grocers',
    description: 'Hyper-local farm-fresh grocery delivery within 30 minutes, featuring live cart drawer and grower traceability.',
    tags: ['React', 'Tailwind CSS', 'E-Commerce', 'UX Design'],
    github: 'https://github.com/manthanank/freshcart-landing',
    live: 'https://freshcart-landing.vercel.app',
    slug: 'freshcart-landing',
  },
  {
    title: 'Landing Forge',
    description: 'Production-ready Next.js landing page scaffolding and preset architecture engine for high-velocity software engineering.',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Developer Tools'],
    github: 'https://github.com/manthanank/landing-forge',
    live: 'https://landing-forge-app.vercel.app',
    slug: 'landing-forge',
  },
];

const DEVTO_USERNAME = 'manthanank';

// Get local posts
const localPosts = await getCollection('blog', ({ data }) => !data.draft);

// Get Dev.to posts
let devtoPosts = [];
try {
  const res = await fetch(`https://dev.to/api/articles?username=${DEVTO_USERNAME}`);
  if (res.ok) {
    const data = await res.json();
    devtoPosts = data.map((article: any) => ({
      data: {
        title: article.title,
        description: article.description,
        pubDate: new Date(article.published_at),
        tags: article.tag_list,
      },
      url: article.url,
    }));
  }
} catch (e) {
  console.warn('Failed to fetch posts from Dev.to');
}

// Combine and get latest 3
const latestPosts = [
  ...localPosts.map(post => ({
    data: post.data,
    url: `/blog/${post.id}`,
    slug: post.id
  })),
  ...devtoPosts
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allViews = await db.select().from(PageViews);
const allLikes = await db.select().from(PageLikes);

const viewsMap = new Map(allViews.map(v => [v.slug, v.count]));
const likesMap = new Map(allLikes.map(l => [l.slug, l.count]));
---

<BaseLayout title="Manthan Ankolekar | Full-Stack Software Engineer" description="Manthan Ankolekar is a full-stack software engineer with 3.5+ years of experience in Next.js, Angular, Node.js and Python. Open to full-time roles and freelance projects, remote or on-site.">
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-content">
      <div class="hero-text animate-fade-in">
        <p class="hero-greeting">Hi, my name is</p>
        <h1 class="hero-name">Manthan Ankolekar</h1>
        <h2 class="hero-headline">I <span id="typewriter">build things for the web.</span><span class="cursor" aria-hidden="true">|</span></h2>
        <p class="hero-description">
          I'm a <strong>Full-Stack Software Engineer</strong> with 3.5+ years of experience building scalable web applications, microservices and AI-driven workflows in Next.js, Angular, Node.js and Python. Open to full-time roles and freelance projects, remote or on-site.
        </p>
        <div class="hero-cta">
          <a href="/projects" class="btn btn-primary btn-magnetic">View My Work</a>
          <a href="/contact" class="btn btn-outline btn-magnetic">Get In Touch</a>
          <a href="/resume.pdf" download class="btn btn-ghost">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Resume
          </a>
        </div>
      </div>
      <div class="hero-visual animate-fade-in animate-delay-2">
        <div class="code-window">
          <div class="code-header">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
            <span class="code-filename">developer.ts</span>
          </div>
          <pre class="code-body"><code id="typing-code"></code></pre>
        </div>
      </div>
    </div>
  </section>

  <script>
    function initTypingAnimation() {
      const codeElement = document.getElementById('typing-code');
      if (!codeElement) return;

      const codeHTML = `<span class="kw">const</span> <span class="var">developer</span> = {
  <span class="key">name</span>: <span class="str">"Manthan Ankolekar"</span>,
  <span class="key">role</span>: <span class="str">"Full-Stack Software Engineer"</span>,
  <span class="key">skills</span>: [<span class="str">"Next.js"</span>, <span class="str">"Angular"</span>,
           <span class="str">"Node.js"</span>, <span class="str">"Python"</span>],
  <span class="key">passion</span>: <span class="str">"Building great UX"</span>,
  <span class="key">coffee</span>: <span class="bool">true</span>,
};`;
      
      // Split with tags preserved as atomic parts
      const parts = codeHTML.match(/<[^>]+>|[^<]/g) || [];
      let i = 0;

      const typingSpeed = 30;

      function type() {
        if (i < parts.length) {
          const part = parts[i];
          if (codeElement) codeElement.innerHTML += part;
          i++;
          
          // If it's a tag, type next immediately, otherwise wait
          if (part.startsWith('<')) {
            type();
          } else {
            setTimeout(type, typingSpeed);
          }
        }
      }

      // Start typing after a delay
      if (codeElement) codeElement.innerHTML = "";
      setTimeout(type, 1000);

      // Click listener for code interactive elements
      codeElement.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('bool')) {
          const isTrue = target.innerText === 'true';
          target.innerText = isTrue ? 'false' : 'true';
          target.style.color = isTrue ? '#f38ba8' : '#fab387'; // Red for false, Peach for true
          
          // Personality touch: Toggle a status icon if it exists
          const pulse = document.querySelector('.pulse-icon') as HTMLElement;
          if (pulse) {
            pulse.style.background = isTrue ? '#f38ba8' : '#a6e3a1';
            pulse.style.opacity = isTrue ? '0.5' : '1';
          }
        }
      });
    }

    function initHeadlineTyping() {
      const element = document.getElementById('typewriter');
      if (!element) return;

      const phrases = [
        "build things for the web.",
        "create scalable systems.",
        "design modern UIs.",
        "develop full-stack apps.",
        "solve complex problems."
      ];
      
      let phraseIndex = 0;
      let charIndex = phrases[0].length;
      let isDeleting = true;

      function type() {
        const currentPhrase = phrases[phraseIndex];
        let typingSpeed = isDeleting ? 50 : 100;

        if (isDeleting) {
          charIndex--;
        } else {
          charIndex++;
        }

        if (element) element.textContent = currentPhrase.substring(0, charIndex);

        if (!isDeleting && charIndex === currentPhrase.length) {
          isDeleting = true;
          typingSpeed = 2000; // Pause at end
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          typingSpeed = 500; // Pause before next
        }

        setTimeout(type, typingSpeed);
      }

      // Initial start
      setTimeout(type, 1000);
    }

    function initAnimations() {
      // Use requestAnimationFrame for the first call to ensure the browser is ready
      requestAnimationFrame(() => {
        initTypingAnimation();
        initHeadlineTyping();
      });
    }

    // Run on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAnimations);
    } else {
      initAnimations();
    }

    // Run after view transitions (Astro specific)
    document.addEventListener('astro:after-swap', initAnimations);
  </script>
  <!-- Skills Section -->
  <section class="section skills-section">
    <div class="container">
      <h2 class="section-title">Technologies I Work With</h2>
      <p class="section-subtitle">My core tech stack and tools I use daily</p>
      <div class="skills-grid reveal">
        {skills.map((skill, index) => (
          <div class={`reveal reveal-delay-${(index % 5) + 1}`}>
            <SkillBadge name={skill} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Work Systems Section (Tech Ventures Group) -->
  <section class="section work-systems-section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Production Work Systems</h2>
        <p class="section-subtitle">Mission-critical platforms built at <strong>Tech Ventures Group</strong> for automotive dealerships and healthcare providers</p>
      </div>
      <div class="projects-grid">
        {workProjects.map((project, index) => (
          <div class={`reveal reveal-delay-${(index % 3) + 1}`}>
            <ProjectCard 
              {...project} 
              views={project.slug ? viewsMap.get(project.slug) : undefined} 
              likes={project.slug ? likesMap.get(project.slug) : undefined} 
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Production Landing Pages Section -->
  <section class="section landing-systems-section">
    <div class="container">
      <div class="section-title-wrapper">
        <h2 class="section-title">Interactive Landing Page Systems</h2>
        <p class="section-subtitle">High-performance marketing platforms, component engines, and interactive telemetry sandboxes</p>
      </div>
      <div class="projects-grid">
        {landingProjects.map((project, index) => (
          <div class={`reveal reveal-delay-${(index % 3) + 1}`}>
            <ProjectCard 
              {...project} 
              views={project.slug ? viewsMap.get(project.slug) : undefined} 
              likes={project.slug ? likesMap.get(project.slug) : undefined} 
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TheLearningHubOrg Spotlight Section -->
  <section class="section learninghub-spotlight-section">
    <div class="container">
      <div class="learninghub-spotlight-card reveal">
        <div class="learninghub-spotlight-content">
          <div class="learninghub-badge">Open Source Organization</div>
          <h2 class="learninghub-heading">TheLearningHubOrg</h2>
          <p class="learninghub-lead">
            Curating comprehensive open-source engineering curricula across <strong>30 repositories</strong>: deep-dive guides into TypeScript strict mode, Angular 19+ Signals, React 19, distributed System Design, Docker, Kubernetes, and Cloud Infrastructure.
          </p>
          <div class="learninghub-actions">
            <a href="https://github.com/TheLearningHubOrg" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-magnetic">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              Explore 30 Repos on GitHub
            </a>
            <a href="/projects#learninghub" class="btn btn-outline">View All Curricula</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Blog Posts -->
  {latestPosts.length > 0 && (
    <section class="section blog-preview-section">
      <div class="container">
        <h2 class="section-title">Latest Articles</h2>
        <p class="section-subtitle">Recent posts from my blog</p>
        <div class="blog-preview-grid">
          {latestPosts.map((post, index) => (
            <div class={`reveal reveal-delay-${(index % 3) + 1}`}>
              <BlogCard
                title={post.data.title}
                excerpt={post.data.description}
                date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                tags={post.data.tags}
                url={post.url}
                views={post.slug ? viewsMap.get(post.slug) : undefined}
                likes={post.slug ? likesMap.get(post.slug) : undefined}
              />
            </div>
          ))}
        </div>
        <div class="view-all">
          <a href="/blog" class="btn btn-outline">View All Posts</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section cta-section">
    <div class="container cta-content">
      <h2 class="cta-title">Interested in working together?</h2>
      <p class="cta-text">
        I'm always open to discussing new projects, creative ideas, or opportunities to be part of your visions.
      </p>
      <a href="/contact" class="btn btn-primary">Say Hello</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 70px;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-greeting {
    font-family: var(--font-mono);
    color: var(--color-primary);
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .hero-name {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, #fff, var(--color-text));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-headline {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
    min-height: 1.2em; /* Prevent layout shift */
  }

  .cursor {
    color: var(--color-primary);
    animation: blink 1s step-end infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    from, to { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-description {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    max-width: 520px;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .hero-description strong {
    color: var(--color-primary);
    font-weight: 600;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1.25rem;
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.9rem;
    border-radius: 50px;
    transition: all var(--transition);
  }

  .btn-ghost:hover {
    color: var(--color-primary);
    background: rgba(0, 212, 255, 0.06);
  }

  /* ===== Code Window ===== */
  .code-window {
    background: #1e1e2e;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    animation: float 6s ease-in-out infinite;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.75rem 1rem;
    background: #181825;
    border-bottom: 1px solid var(--color-border);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.red { background: #f38ba8; }
  .dot.yellow { background: #f9e2af; }
  .dot.green { background: #a6e3a1; }

  .code-filename {
    margin-left: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .code-body {
    padding: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.8;
    overflow-x: auto;
    color: #cdd6f4; /* Force light text color for dark code window */
  }

  .code-body .kw { color: #cba6f7; }
  .code-body .var { color: #89b4fa; }
  .code-body .key { color: #89dceb; }
  .code-body .str { color: #a6e3a1; }
  .code-body .bool { color: #fab387; }

  /* ===== Skills ===== */
  .skills-section {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  /* ===== Projects ===== */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 1.5rem;
  }

  .view-all {
    text-align: center;
    margin-top: 3rem;
  }

  /* ===== Blog Preview ===== */
  .blog-preview-section {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr));
    gap: 1.5rem;
  }

  /* ===== CTA ===== */
  .cta-section {
    text-align: center;
  }

  .cta-content {
    max-width: 600px;
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--color-gradient-start), var(--color-gradient-end));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .cta-text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  /* ===== TheLearningHubOrg Spotlight ===== */
  .learninghub-spotlight-section {
    padding-top: 1rem;
    padding-bottom: 2rem;
  }

  .learninghub-spotlight-card {
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.08) 0%, rgba(124, 58, 237, 0.08) 100%);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 3rem 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .learninghub-spotlight-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .learninghub-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 0.75rem;
    background: rgba(0, 212, 255, 0.1);
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    border: 1px solid rgba(0, 212, 255, 0.2);
  }

  .learninghub-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.5px;
  }

  .learninghub-lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 760px;
    margin-bottom: 2rem;
  }

  .learninghub-lead strong {
    color: var(--color-text);
  }

  .learninghub-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }

  @media (max-width: 1024px) {
    .hero-content {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-top: 100px;
      padding-bottom: 2rem;
    }

    .hero-content {
