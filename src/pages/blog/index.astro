---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { db, PageViews, PageLikes } from 'astro:db';

const DEVTO_USERNAME = 'manthanank';

// Get local posts with reading time
const localPosts = await getCollection('blog', ({ data }) => !data.draft);

// Get Dev.to posts
let devtoPosts = [];
try {
  const res = await fetch(`https://dev.to/api/articles?username=${DEVTO_USERNAME}`);
  if (res.ok) {
    const data = await res.json();
    devtoPosts = data.map((article: any) => ({
      data: {
        title: article.title,
        description: article.description,
        pubDate: new Date(article.published_at),
        tags: article.tag_list,
      },
      url: article.url,
      isExternal: true,
      readingTime: article.reading_time_minutes || undefined
    }));
  }
} catch (e) {
  console.warn('Failed to fetch posts from Dev.to');
}

// Calculate reading time for local posts
function calculateReadingTime(body: string | undefined): number {
  if (!body) return 1;
  const wordCount = body.split(/\s+/g).length;
  return Math.max(1, Math.round(wordCount / 200));
}

// Combine and sort
const posts = [
  ...localPosts.map(post => ({
    data: post.data,
    url: `/blog/${post.id}`,
    slug: post.id,
    isExternal: false,
    readingTime: calculateReadingTime(post.body)
  })),
  ...devtoPosts
].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = Array.from(new Set(posts.flatMap(p => p.data.tags || []))).sort();

const allViews = await db.select().from(PageViews);
const allLikes = await db.select().from(PageLikes);

const viewsMap = new Map(allViews.map(v => [v.slug, v.count]));
const likesMap = new Map(allLikes.map(l => [l.slug, l.count]));
---

<BaseLayout title="Blog | Manthan Ankolekar" description="Thoughts, tutorials, and insights on web development">
  <section class="section blog-hero">
    <div class="container">
      <h1 class="section-title">Blog</h1>
      <p class="section-subtitle">Thoughts, tutorials, and insights on web development</p>
    </div>
  </section>

  <section class="container blog-section">
    <div class="blog-controls reveal">
      <div class="blog-search-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="blog-search" type="search" placeholder="Search posts by title, tag, or description…" autocomplete="off" spellcheck="false" aria-label="Search blog posts" />
        <span id="blog-count" class="blog-count">{posts.length} posts</span>
      </div>
      <div class="tag-filters" id="tag-filters">
        <button class="tag-filter-btn active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="tag-filter-btn" data-tag={tag.toLowerCase()}>{tag}</button>
        ))}
      </div>
    </div>

    <div class="blog-grid" id="blog-grid">
      {posts.map((post) => (
        <div class="blog-item" data-title={post.data.title.toLowerCase()} data-description={(post.data.description || '').toLowerCase()} data-tags={(post.data.tags || []).map((t: string) => t.toLowerCase()).join(' ')}>
          <BlogCard
            title={post.data.title}
            excerpt={post.data.description}
            date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            tags={post.data.tags}
            url={post.url}
            readingTime={post.readingTime}
            views={post.slug ? viewsMap.get(post.slug) : undefined}
            likes={post.slug ? likesMap.get(post.slug) : undefined}
          />
        </div>
      ))}
    </div>

    <div id="blog-empty" class="blog-empty" style="display:none;">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <p>No posts found. Try a different search or tag.</p>
      <button class="btn btn-outline" id="reset-search">Clear filters</button>
    </div>

    <div class="blog-cta">
      <p>I also write on Medium about web development topics.</p>
      <a href="https://medium.com/@manthanank" target="_blank" rel="noopener noreferrer" class="btn btn-outline">
        Read More on Medium
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  function initBlogFilter() {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const tagButtons = document.querySelectorAll('.tag-filter-btn');
    const blogItems = document.querySelectorAll('.blog-item') as NodeListOf<HTMLElement>;
    const countEl = document.getElementById('blog-count');
    const emptyEl = document.getElementById('blog-empty');
    const resetBtn = document.getElementById('reset-search');
    if (!searchInput) return;
    let activeTag = 'all', searchQuery = '';

    function filterPosts() {
      let visible = 0;
      blogItems.forEach(item => {
        const title = item.dataset.title || '';
        const desc = item.dataset.description || '';
        const tags = item.dataset.tags || '';
        const matchSearch = !searchQuery || title.includes(searchQuery) || desc.includes(searchQuery) || tags.includes(searchQuery);
        const matchTag = activeTag === 'all' || tags.split(' ').some(t => t === activeTag);
        item.style.display = (matchSearch && matchTag) ? '' : 'none';
        if (matchSearch && matchTag) visible++;
      });
      if (countEl) countEl.textContent = visible + ' post' + (visible !== 1 ? 's' : '');
      if (emptyEl) emptyEl.style.display = visible === 0 ? 'flex' : 'none';
    }

    searchInput.addEventListener('input', () => { searchQuery = searchInput.value.trim().toLowerCase(); filterPosts(); });
    tagButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tagButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeTag = btn.getAttribute('data-tag') || 'all';
        filterPosts();
      });
    });
    resetBtn?.addEventListener('click', () => {
      searchInput.value = ''; searchQuery = '';
      tagButtons.forEach(b => b.classList.remove('active'));
      (tagButtons[0] as HTMLElement)?.classList.add('active');
      activeTag = 'all'; filterPosts();
    });
  }
  initBlogFilter();
  document.addEventListener('astro:after-swap', initBlogFilter);
</script>

<style>
  .blog-hero { padding-top: 8rem; padding-bottom: 0; }
  .blog-section { padding-bottom: 5rem; }
  .blog-controls { margin: 2rem 0; display: flex; flex-direction: column; gap: 1rem; }
  .blog-search-wrapper { display: flex; align-items: center; gap: 0.75rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 0.75rem 1.25rem; transition: border-color var(--transition), box-shadow var(--transition); }
  .blog-search-wrapper:focus-within { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(0,212,255,0.08); }
  .blog-search-wrapper svg { color: var(--color-text-muted); flex-shrink: 0; }
  #blog-search { flex: 1; border: none; outline: none; background: none; color: var(--color-text); font-size: 1rem; font-family: var(--font-sans); }
  #blog-search::placeholder { color: var(--color-text-muted); }
  .blog-count { font-size: 0.82rem; font-family: var(--font-mono); color: var(--color-text-muted); white-space: nowrap; background: var(--color-bg-alt); padding: 0.2rem 0.6rem; border-radius: 20px; border: 1px solid var(--color-border); }
  .tag-filters { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag-filter-btn { font-size: 0.82rem; font-weight: 600; padding: 0.35rem 0.85rem; border-radius: 99px; background: var(--color-bg-alt); border: 1px solid var(--color-border); color: var(--color-text-muted); cursor: pointer; transition: all var(--transition); white-space: nowrap; font-family: inherit; }
  .tag-filter-btn:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .tag-filter-btn.active { background: var(--color-primary); color: #000; border-color: var(--color-primary); box-shadow: 0 4px 12px rgba(0,212,255,0.25); }
  .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 1.5rem; }
  .blog-item { display: block; }
  .blog-empty { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding: 4rem 2rem; text-align: center; color: var(--color-text-muted); border: 1px dashed var(--color-border); border-radius: var(--radius); margin: 1rem 0 2rem; }
  .blog-empty svg { opacity: 0.4; }
  .blog-cta { text-align: center; margin-top: 4rem; padding: 3rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .blog-cta p { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 1.05rem; }
  @media (max-width: 768px) {
    .blog-hero { padding-top: 6rem; }
    .blog-grid { grid-template-columns: 1fr; gap: 1rem; }
    .blog-cta { padding: 2rem 1.25rem; margin-top: 3rem; }
  }
  @media (max-width: 480px) { .blog-cta { padding: 1.5rem 1rem; } }
</style>
